{"nodes": [{"id": "minimaofficial_site_futurecash_guide", "label": "Future Cash user guide", "file_type": "document", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "minimaofficial_site_futurecash_guide_timelock", "label": "Time-lock stakes", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 120,156-166", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locks MINIMA so it can only be spent after a chosen date/block; enforced by the blockchain so nobody \u2014 not even the owner \u2014 can unlock early."}, {"id": "minimaofficial_site_futurecash_guide_guardian", "label": "Guardian background daemon", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 126,168-180", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs as a background daemon with the node, checking stakes on every new block and collecting matured ones unattended."}, {"id": "minimaofficial_site_futurecash_guide_collect_flow", "label": "Collect flow", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 168-180,221", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matured safe stakes are auto-collected (given a fresh audit under 30 min); each stake also has manual Collect now, and the Guardian tab has Collect all now."}, {"id": "minimaofficial_site_futurecash_guide_maturity", "label": "Stake maturity (Pending/Matured)", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 163,168", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stake sits under Pending with a countdown until its unlock date, then moves to Matured where the Guardian collects it."}, {"id": "minimaofficial_site_futurecash_guide_keyreuse", "label": "WOTS key-reuse protection", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 130-141,182-201", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minima signs with one-time (WOTS) keys that weaken on reuse; Future Cash audits keys and, for stakes landing on reused addresses, immediately sweeps them to a safe wallet before an attacker can exploit the reused key."}, {"id": "minimaofficial_site_futurecash_guide_audit", "label": "Key audit service", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 143-154,232-238", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sends only public keys/addresses to an external service to detect key reuse; a fresh audit (under 30 min) is required for automatic safe collecting, and an incomplete audit pauses auto-collect for safety."}, {"id": "minimaofficial_site_futurecash_guide_write_read_mode", "label": "WRITE vs READ mode", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "line 152,221", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The daemon must act unattended, so Future Cash requires WRITE mode; in READ mode actions get stuck as pending requests that cannot be approved by hand \u2014 a Minima safety rule only the user can grant."}, {"id": "minimaofficial_site_futurecash_guide_rescue", "label": "Rescue / Harden (at-risk sweep)", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 182-201", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For at-risk stakes the Guardian quick-sweeps to a clean address or hands off to AnyPhraseRecovery for full seed migration; the Harden panel sweeps and retires reused change addresses so fresh money stops landing on them."}, {"id": "minimaofficial_site_futurecash_guide_classic_271", "label": "Classic Future Cash 2.7.1", "file_type": "concept", "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "line 152", "source_url": "https://eurobuddha.com/store/dapps/futurecash-2.7.1.mds.zip", "captured_at": null, "author": null, "contributor": null, "rationale": "A fully manual alternative with no background daemon and no key-reuse protection, offered for users who prefer manual control."}], "edges": [{"source": "minimaofficial_site_futurecash_guide", "target": "minimaofficial_site_futurecash_guide_timelock", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 156-166", "weight": 1.0}, {"source": "minimaofficial_site_futurecash_guide", "target": "minimaofficial_site_futurecash_guide_guardian", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 130-141", "weight": 1.0}, {"source": "minimaofficial_site_futurecash_guide_guardian", "target": "minimaofficial_site_futurecash_guide_collect_flow", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "lines 168-180", "weight": 1.0}, {"source": "minimaofficial_site_futurecash_guide_collect_flow", "target": "minimaofficial_site_futurecash_guide_maturity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "minimaofficial-site/futurecash/guide.html", "source_location": "line 163", "weight": 1.0}, {"source": "minimaofficial_site_futurecash_guide_timelock", "target": "minimaofficial_site_futurecash_guide_maturity"